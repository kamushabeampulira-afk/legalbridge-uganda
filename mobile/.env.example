# Mobile app environment — not used directly by Expo
# Update the BASE_URL in mobile/services/api.ts instead.
#
# For device testing on the same LAN:
# Change 127.0.0.1 to your machine's local IP address e.g. 192.168.1.100
#
# BACKEND_URL=http://192.168.1.100:8000/api
#
# For production:
# BACKEND_URL=https://api.legalbridgeug.org/api

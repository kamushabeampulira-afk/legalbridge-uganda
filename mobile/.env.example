# Mobile app environment
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Copy this file to mobile/.env and set the URL of your deployed backend.

# Local device testing on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api

# Production (Render):
# EXPO_PUBLIC_API_URL=https://legalbridge-api.onrender.com/api
EXPO_PUBLIC_API_URL=

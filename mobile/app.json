{
  "expo": {
    "name": "LegalBridge",
    "slug": "legalbridge-informal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "legalbridge",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#922F7C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.legalbridge.informal"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#922F7C"
      },
      "package": "org.legalbridge.informal",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "LegalBridge needs camera access to photograph documents."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LegalBridge needs photo access to upload documents."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "LegalBridge needs microphone access for voice questions."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

# ============================================================
# LegalBridge Informal — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=legalbridge_db
DB_USER=legalbridge_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- AI provider for legal explanations ---
# Option 1: OpenAI (paid)
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
#
# Option 2: Google Gemini (free tier; key from https://aistudio.google.com/apikey)
# OPENAI_API_KEY=AIza...your-gemini-key...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=<a current Gemini Flash model; run: python manage.py check_ai_services>
# OPENAI_REASONING_EFFORT=low
# OPENAI_EXTRA_MAX_TOKENS=2000
# Note: on the free tier Google may use what is sent to improve its products.
# Use test documents only, not real users' documents.

# --- Africa's Talking (USSD) ---
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SHORTCODE=*384*0#
AT_ENVIRONMENT=sandbox   # sandbox | production

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=legalbridge_sources

# --- File Storage ---
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10

# --- Voice / Speech ---
# Free option with Luganda support: Sunbird AI (set TTS_PROVIDER=sunbird and STT_PROVIDER=sunbird).
# Register at https://api.sunbird.ai/register, then copy the token from https://api.sunbird.ai/keys
SUNBIRD_API_TOKEN=
SUNBIRD_TTS_VOICE_EN=         # empty = Grace; also Olivia, Daniel
SUNBIRD_TTS_VOICE_LG=         # empty = Namuli; also Kato, Nakato, Wasswa, Babirye, Kizza
#
# ElevenLabs (TTS) or similar
TTS_PROVIDER=elevenlabs       # sunbird | elevenlabs | openai
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_LG=        # Luganda voice ID when available

# STT Provider
STT_PROVIDER=openai_whisper   # sunbird | openai_whisper
# OpenAI key for Whisper / OpenAI TTS. Only needed when OPENAI_BASE_URL points to another
# provider; otherwise OPENAI_API_KEY is used.
VOICE_OPENAI_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Admin ---
ADMIN_EMAIL=admin@legalbridgeug.org

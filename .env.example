# ============================================================
# LegalBridge Informal — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Django ---
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=legalbridge_db
DB_USER=legalbridge_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- OpenAI ---
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o

# --- Africa's Talking (USSD) ---
AT_USERNAME=sandbox
AT_API_KEY=your-africastalking-api-key
AT_SHORTCODE=*384*0#
AT_ENVIRONMENT=sandbox   # sandbox | production

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=legalbridge_sources

# --- File Storage ---
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=10

# --- Voice / Speech ---
# ElevenLabs (TTS) or similar
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_EN=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_LG=

# STT Provider
STT_PROVIDER=openai_whisper

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=20

# --- Admin ---
ADMIN_EMAIL=admin@legalbridgeug.org
